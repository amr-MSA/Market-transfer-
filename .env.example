TELEGRAM_BOT_TOKEN=
# Channel list now lives in config/channels.json (per-channel id/name/enabled),
# not in an env var. Add a channel = add an entry with "enabled": true.

# Optional official social verification
X_API_BEARER_TOKEN=
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_APP_IG_USER_ID=

# Optional Gemini fallback extraction (used only when the regex parser
# can't confidently parse a "here we go" post). Free tier is generous for
# this bot's volume. Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
