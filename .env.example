TELEGRAM_BOT_TOKEN=
# Channel list now lives in config/channels.json (per-channel id/name/enabled),
# not in an env var. Add a channel = add an entry with "enabled": true.

# Optional official social verification
X_API_BEARER_TOKEN=
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_APP_IG_USER_ID=

# Gemini is required for the year-round news layer. It returns a structured
# event (type, from, to, player) before the bot checks the weekly duplicate
# list and routes the article to subscribed channels. It also remains the
# fallback when a Here We Go post cannot be parsed safely by regex.
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
